NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://communications-api.example.com
FRONTEND_ORIGIN=https://nationalarchivesusar.github.io
FRONTEND_PATH=/communications-studio/
DATABASE_PATH=./data/communications-studio.sqlite
SESSION_TTL_DAYS=30
OAUTH_TTL_MINUTES=10
AUTHZ_CACHE_SECONDS=300
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
REQUIRE_DISCORD=true

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
