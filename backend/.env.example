DISCORD_GUILD_ID=886068973886640129
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://communications-api.example.com/auth/discord/callback

ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://communications-api.example.com/auth/roblox/callback

# Approved publication channels.
CHANNEL_WHITE_HOUSE=899467464826556427
CHANNEL_EXECUTIVE=886076674792390707
CHANNEL_LEGISLATIVE=886077286414172171
CHANNEL_JUDICIAL=886077834911678464

