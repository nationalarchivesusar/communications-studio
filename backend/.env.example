NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://communications-api.example.com
FRONTEND_ORIGIN=https://nationalarchivesusar.github.io
FRONTEND_PATH=/communications-studio/
DATABASE_PATH=./data/communications-studio.sqlite
SESSION_TTL_DAYS=30
OAUTH_TTL_MINUTES=10
AUTHZ_CACHE_SECONDS=300
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
REQUIRE_DISCORD=true

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Canonical USAR Discord server where the Communications Studio app/bot will be installed.
DISCORD_GUILD_ID=886068973886640129
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://communications-api.example.com/auth/discord/callback

ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://communications-api.example.com/auth/roblox/callback

# Optional notification roles. Users only get an on/off toggle; the server owns IDs.
PING_ROLE_WHITE_HOUSE=
PING_ROLE_EXECUTIVE=
PING_ROLE_LEGISLATIVE=
PING_ROLE_MILITARY=
PING_ROLE_JUDICIAL=
PING_ROLE_INDEPENDENT=
